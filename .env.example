# CircuiTry3D — build-time environment.
#
# Copy to `.env` (which is gitignored) and fill in. Everything here is inlined
# into the bundle by Vite at build time, so treat every value as PUBLIC. Do not
# put an API key or any secret in this file — that is what the ai-proxy worker
# exists for.

# ── Affiliate links ─────────────────────────────────────────────────────────
# See docs/AFFILIATE-SETUP.md for how to get these.
#
# With NO tag set, buy links still render and still open the shop — they simply
# carry no tracking, are not marked "sponsored", and show no disclosure. That
# is the safe state to ship in while an application is pending.

# Your Amazon Associates tracking id for the default marketplace.
# Looks like "yourname-20" (.com), "yourname-21" (.co.uk).
VITE_AMAZON_ASSOCIATES_TAG=

# Which Amazon marketplace the default tag belongs to.
VITE_AMAZON_MARKETPLACE=www.amazon.com

# Extra marketplaces, once you are approved for them. Comma separated,
# host=tag. An Associates account is per-marketplace: a .com tag earns nothing
# on .co.uk, so a marketplace with no entry here gets an untagged link.
# VITE_AMAZON_ASSOCIATES_TAGS=www.amazon.co.uk=yourname-21,www.amazon.ca=yourname-20

# Kill switch. Set to "false" to strip tracking from every link everywhere,
# without removing the links or rebuilding any UI.
VITE_AFFILIATE_ENABLED=true

# Tracking parameters for non-Amazon merchants (Digi-Key, Mouser), if you join
# one of their programmes. Comma separated, key=value.
# VITE_AFFILIATE_EXTRA_PARAMS=utm_source=circuitry3d,partner=1234
